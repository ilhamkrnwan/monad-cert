# ============================================================
# MonadCert — Environment Variables Template
# ============================================================
# Copy file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git!
# ============================================================

# Supabase (dari Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# ============================================================
# DEPLOYMENT CONFIG — Monad Testnet
# ============================================================

# Private key wallet deployer (tanpa prefix 0x)
# Isi testnet MON di: https://faucet.monad.xyz
DEPLOY_PRIVATE_KEY=

# Wallet address Provider Admin (kosongkan = sama dengan deployer)
ADMIN_WALLET=

# Monad RPC URL (gunakan default jika tidak ada)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ============================================================
# POST-DEPLOYMENT (isi setelah contract berhasil di-deploy)
# ============================================================
NEXT_PUBLIC_EDUTRUST_ADDRESS=
